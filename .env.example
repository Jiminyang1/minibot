# MiniBot environment template.
#
# Usage:
#   cp .env.example .env
#   uv sync
#   uv run minibot
#
# Keep real secrets in .env only. Do not commit .env.

# -----------------------------------------------------------------------------
# LLM provider
# -----------------------------------------------------------------------------

# Required. API key for the OpenAI-compatible provider.
OPENAI_API_KEY=

# Optional for OpenAI official API. Required for OpenAI-compatible providers.
# DeepSeek example:
OPENAI_BASE_URL=https://api.deepseek.com

# Model name sent to the provider.
# DeepSeek V4 examples:
#   deepseek-v4-pro
#   deepseek-v4-flash
# OpenAI-compatible examples depend on your provider.
MINIBOT_MODEL=deepseek-v4-pro

# Hard model capabilities are resolved from the provider/model catalog.
# Set both overrides for a new or custom OpenAI-compatible model whose limits
# are not known to MiniBot.
# MINIBOT_CONTEXT_WINDOW_TOKENS=1048576
# MINIBOT_MODEL_MAX_INPUT_TOKENS=1048576
# MINIBOT_MODEL_MAX_OUTPUT_TOKENS=393216

# Maximum output requested from the provider on every model call. This is an
# application choice and must not exceed the model's hard maximum.
MINIBOT_MAX_OUTPUT_TOKENS=32000

# Controls whether provider-specific reasoning_content is preserved in messages.
# Values:
#   auto   - preserve for DeepSeek endpoints/models, strip for OpenAI by default
#   true   - always preserve
#   false  - always strip
MINIBOT_INCLUDE_REASONING_CONTENT=auto

# -----------------------------------------------------------------------------
# Agent runtime
# -----------------------------------------------------------------------------

# Maximum LLM <-> tool loop iterations for one user turn.
MINIBOT_MAX_ITERATIONS=20

# Maximum number of concurrency-safe tool calls to run in parallel.
# Set to 0 or 1 to force serial execution.
MINIBOT_MAX_PARALLEL_TOOLS=4

# Approval mode for tools that normally require permission:
#   ask     - prompt before sensitive tools (default)
#   always  - auto-approve sensitive tools
MINIBOT_APPROVAL_MODE=ask

# Approximate request token threshold that triggers compaction. This is a
# policy threshold, not the model context window. If omitted, MiniBot uses the
# hard input limit (context window minus MINIBOT_MAX_OUTPUT_TOKENS).
MINIBOT_COMPACT_TOKEN_THRESHOLD=300000

# Recent history retained verbatim when older history is summarized.
MINIBOT_COMPACT_KEEP_RECENT_TOKENS=16000

# Legacy alias for MINIBOT_MAX_OUTPUT_TOKENS. Do not set both.
# MINIBOT_RESERVED_COMPLETION_TOKENS=32000

# -----------------------------------------------------------------------------
# MCP and local servers
# -----------------------------------------------------------------------------

# Optional. MiniBot-global MCP config path. Can point to an mcp.json file or a
# directory containing mcp.json. If unset, MiniBot uses ~/.minibot/mcp.json when
# present, otherwise the bundled mcp.json in the MiniBot install directory.
# MINIBOT_MCP_CONFIG_PATH=/Users/you/.minibot/mcp.json

# Optional. Used by mcp_servers/sqlite_server.py if that server is configured
# to read SQLITE_PATH from its transport env in mcp.json.
# SQLITE_PATH=/absolute/path/to/database.sqlite3

# Optional examples for streamable_http MCP server auth headers in mcp.json.
# If mcp.json contains a value like "Authorization": "Bearer ${FIGMA_MCP_TOKEN}",
# the variable must be set here or in the process environment.
# FIGMA_MCP_TOKEN=

# -----------------------------------------------------------------------------
# Tests and terminal behavior
# -----------------------------------------------------------------------------

# macOS integration tests are skipped unless this is explicitly set to 1.
MINIBOT_RUN_MACOS_INTEGRATION=0

# Disable ANSI color in terminal output when set to any value.
# NO_COLOR=1
